{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tekscape-inc/factory-standard/schema/evidence.schema.json",
  "title": "evidence.json — written by the gate runner, never by an agent (plan v3 §5.2, 03 §4.2)",
  "type": "object",
  "required": ["schema_version", "card", "repo", "gates", "result"],
  "additionalProperties": false,
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "paths": {"type": "array", "items": {"type": "string"}},
    "who": {"type": "object", "required": ["vendor"], "additionalProperties": false,
            "properties": {"vendor": {"type": "string"}, "model": {"type": "string"}}}
  },
  "properties": {
    "schema_version": {"const": 1},
    "card": {"type": "object", "required": ["id", "c0_sha", "card_sha256"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "c0_sha": {"$ref": "#/$defs/sha1"}, "card_sha256": {"$ref": "#/$defs/sha256"}}},
    "repo": {"type": "object", "required": ["github", "base_sha", "head_sha", "tree_sha"], "additionalProperties": false,
      "properties": {"github": {"type": "string"}, "base_sha": {"$ref": "#/$defs/sha1"},
                     "head_sha": {"$ref": "#/$defs/sha1"}, "tree_sha": {"$ref": "#/$defs/sha1"}}},
    "attempt": {"type": "object", "required": ["n", "lane"], "additionalProperties": false,
      "properties": {"n": {"type": "integer", "minimum": 1}, "lane": {"enum": ["qwen", "coder-pro"]},
                     "author": {"$ref": "#/$defs/who"}, "started_at": {"type": "string"}, "finished_at": {"type": "string"}}},
    "runner": {"type": "object", "additionalProperties": false,
      "properties": {"factory_version": {"type": "string"}, "host": {"enum": ["mac-local", "gha"]},
                     "manifest_sha256": {"$ref": "#/$defs/sha256"}}},
    "gates": {"type": "array", "items": {
      "type": "object", "required": ["name", "status"], "additionalProperties": false,
      "properties": {
        "name": {"type": "string"}, "source": {"enum": ["card", "manifest", "builtin"]},
        "command": {"type": ["string", "null"]}, "exit_code": {"type": ["integer", "null"]},
        "duration_ms": {"type": "integer", "minimum": 0}, "log_path": {"type": "string"},
        "log_sha256": {"$ref": "#/$defs/sha256"},
        "tests": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["executed", "failed", "skipped"],
          "additionalProperties": false, "properties": {"executed": {"type": "integer", "minimum": 0},
          "failed": {"type": "integer", "minimum": 0}, "skipped": {"type": "integer", "minimum": 0}}}]},
        "status": {"enum": ["pass", "fail", "absent"]}}}},
    "scope": {"type": "object", "additionalProperties": false, "properties": {
      "files_changed": {"type": "integer", "minimum": 0}, "lines_added": {"type": "integer", "minimum": 0},
      "lines_deleted": {"type": "integer", "minimum": 0},
      "budget": {"type": "object", "required": ["files", "lines"], "additionalProperties": false,
        "properties": {"files": {"type": "integer"}, "lines": {"type": "integer"}}},
      "outside_writable": {"$ref": "#/$defs/paths"}, "protected_touched": {"$ref": "#/$defs/paths"},
      "new_deps": {"type": "array", "items": {"type": "object", "required": ["ecosystem", "name"],
        "additionalProperties": false, "properties": {"ecosystem": {"type": "string"}, "name": {"type": "string"}}}},
      "acceptance_restored": {"type": "boolean"}, "acceptance_modified_by_worker": {"$ref": "#/$defs/paths"},
      "human_gate_reasons": {"type": "array", "items": {"type": "string"}}}},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["kind", "path", "sha256"],
      "additionalProperties": false, "properties": {"kind": {"enum": ["screenshot", "trace", "junit", "log", "video"]},
        "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "journey": {"type": "string"}}}},
    "judge": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["vendor", "verdict", "sha"],
      "additionalProperties": false, "properties": {"vendor": {"type": "string"}, "model": {"type": "string"},
        "verdict": {"enum": ["PASS", "BLOCK", "HUMAN"]}, "sha": {"$ref": "#/$defs/sha1"},
        "findings_count": {"type": "integer", "minimum": 0}, "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "status_url": {"type": "string"}}}]},
    "audit": {"type": "object", "required": ["sampled"], "additionalProperties": false,
      "properties": {"sampled": {"type": "boolean"}, "verdict": {"enum": ["PASS", "BLOCK", "HUMAN"]}, "miss": {"type": "boolean"}}},
    "result": {"enum": ["pass", "fail", "tamper", "needs_context"]}
  }
}
